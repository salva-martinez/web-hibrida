# ============================================================
#  Variables de entorno para PRODUCCIÓN (VPS)
#  Copia este fichero a .env en el servidor y ajusta los valores.
#  El .env NUNCA se sube al repositorio.
# ============================================================

APP_NAME=FisioApp
APP_ENV=production
APP_KEY=            # php artisan key:generate
APP_DEBUG=false
APP_URL=https://fisio.salvamartinez.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
# Los logs dentro del contenedor se muestran con: sail logs -f laravel.test

# --- Base de datos ---
# Dentro de Docker, el host del servicio MySQL es "mysql" (no 127.0.0.1).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fisioterapia
DB_USERNAME=sail
DB_PASSWORD=password

# --- Sesión ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# IMPORTANTE con HTTPS: marca la cookie como "Secure".
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Cola (análisis de IA del feedback) ---
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo (verificación de email de los fisioterapeutas) ---
# MAIL_MAILER=log solo escribe el email en el log: en producción hay que
# configurar un SMTP real (Mailgun, SES, SMTP del hosting...).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@salvamartinez.es"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (opcional, para backups de S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- IA ---
GEMINI_API_KEY=      # https://aistudio.google.com/apikey

# --- Puertos de Sail en el servidor ---
# Deben coincidir con el vhost de nginx (deploy/nginx/fisioapp.conf).
# 18081: la app (nginx hace de proxy inverso hacia 127.0.0.1:18081)
# 3306: MySQL, publicado SOLO en 127.0.0.1
APP_PORT=18081
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
